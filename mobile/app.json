{
  "expo": {
    "name": "Delvo",
    "slug": "delvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07162A"
      },
      "package": "com.gromber05.delvo",
      "permissions": ["SCHEDULE_EXACT_ALARM", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "androidStatusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#0F1923",
        "translucent": false
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gromber05.delvo"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C63FF",
          "sounds": []
        }
      ]
    ],
    "scheme": "delvo",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "df10e9a8-a6fd-427b-9d1b-39e56a0c7cb6"
      }
    }
  }
}
